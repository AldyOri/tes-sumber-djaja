{
  "name": "warehouse-stock-transfer-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for warehouse stock transfers (Case 2)",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "db:check": "drizzle-kit check --dialect=mysql --out=./drizzle",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
