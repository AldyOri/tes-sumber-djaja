NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=mysql://warehouse:warehouse_dev@127.0.0.1:3306/warehouse_transfer
DB_POOL_SIZE=10
DB_LOCK_TIMEOUT_SECONDS=5
